# .env.example (Artifact 13.1, Q13.11): every setting in src/aisre/config.py.
# Copy to .env for local work; .env is gitignored. Every value here is FAKE.
# Compose reads .env itself; for host commands use `uv run --env-file .env ...`.
# Production values come from a secrets manager, never from a file.

# development | test | production. Tests refuse to run unless this is unset or test.
AISRE_ENV=development

# One URL per database role (ADR-51). Hosts are the Compose services.
AISRE_DATABASE_URL=postgresql+psycopg://aisre_app:fake-app-password@postgres:5432/aisre
AISRE_DISPATCHER_DATABASE_URL=postgresql+psycopg://aisre_dispatcher:fake-dispatcher-password@postgres:5432/aisre
AISRE_MIGRATION_DATABASE_URL=postgresql+psycopg://aisre_owner:fake-owner-password@postgres:5432/aisre

AISRE_TEMPORAL_ADDRESS=temporal:7233
AISRE_TEMPORAL_NAMESPACE=default

# DEBUG | INFO | WARNING | ERROR
AISRE_LOG_LEVEL=INFO

# Bearer-token sign-in (T1.3). Here, Compose's FAKE token issuer (ops/fakes/token_issuer.py),
# local use only. All three or none; with none, the API takes the development-only
# X-Aisre-Dev-Caller header instead, and only when AISRE_ENV is development or test.
AISRE_OIDC_ISSUER=http://token-issuer:8080
AISRE_OIDC_AUDIENCE=aisre-api
AISRE_OIDC_JWKS_URL=http://token-issuer:8080/jwks

# The worker answers the activities not built yet with fixed, scripted results
# (aisre.workflow.scripted): the slot, the spend state and draft_patch, and the model skills when
# no provider key is set below. Refused when AISRE_ENV is production.
AISRE_SCRIPTED_SKILLS=true
# Seconds each scripted skill step waits first (0 to 10). The M0 demo sets 3, so that a
# worker kill lands in the middle of a run.
AISRE_SCRIPTED_STEP_SECONDS=0

# Evidence (T1.10, T1.17). JSON naming the source for each READ tool; unset, the worker answers
# collect_evidence and retrieve_knowledge with scripts. Here, Compose's FAKE monitoring source
# replaying the reference incident up to its evidence cut-off. The fake adapter and
# replay_as_of are refused in production.
AISRE_EVIDENCE_SOURCES={"sources":{"*":{"adapter":"fake_monitoring","url":"http://fake-monitoring:8080/v1/scenarios/reference-incident"}},"replay_as_of":"2026-10-20T14:20:00Z"}
# The Model Gateway (T1.8, T1.18). With a key, hypothesise, diagnose and review_diagnosis are the
# real skills, calling the provider through the Anthropic transport; without one they stay
# scripted (above). Here, Compose's FAKE provider (ops/fakes/model_provider.py), answering from
# its scripts, and a FAKE key it only checks is present. A real key comes from a secrets manager.
AISRE_PROVIDER_URL=http://fake-provider:8080
AISRE_PROVIDER_API_KEY=fake-provider-key
# prompts/<task>/v<N>.md, relative to the working directory (the image's /app).
AISRE_PROMPTS_DIR=prompts

# Evidence snapshots (ADR-57): all four or none. Here, the local MinIO's root credentials.
AISRE_OBJECT_STORE_URL=http://minio:9000
AISRE_OBJECT_STORE_BUCKET=aisre-artifacts
AISRE_OBJECT_STORE_ACCESS_KEY=fake-minio-admin
AISRE_OBJECT_STORE_SECRET_KEY=fake-minio-password

# Write-once audit copy (T1.20): URL, bucket and both keys, or none (then only the chain is
# checked). The bucket must be created with Object Lock (Compose's minio-bucket job does).
# LOCK_DAYS sets COMPLIANCE retention per object: nobody, the store's administrator
# included, deletes it before then. 1 here, so a local store stays disposable.
AISRE_AUDIT_STORE_URL=http://minio:9000
AISRE_AUDIT_STORE_BUCKET=aisre-audit
AISRE_AUDIT_STORE_ACCESS_KEY=fake-minio-admin
AISRE_AUDIT_STORE_SECRET_KEY=fake-minio-password
AISRE_AUDIT_STORE_LOCK_DAYS=1

# Ed25519 private key (32 bytes, base64) that signs incident exports. Required in production;
# empty here, so each API start signs with a fresh throwaway key.
AISRE_EXPORT_SIGNING_KEY=

# Telemetry (T1.19). OpenTelemetry's own variable: spans go to the collector's OTLP/HTTP
# receiver. AISRE_METRICS_PORT serves /metrics, inside the Compose network only. Unset, off.
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
AISRE_METRICS_PORT=9464

# ---------------------------------------------------------------------------
# Compose only (compose.yaml, ops/compose/postgres-init.sh). Not read by the application.
# The role passwords must match the ones inside the URLs above.
POSTGRES_PASSWORD=fake-superuser-password
AISRE_OWNER_PASSWORD=fake-owner-password
AISRE_APP_PASSWORD=fake-app-password
AISRE_DISPATCHER_PASSWORD=fake-dispatcher-password
TEMPORAL_DB_PASSWORD=fake-temporal-password

# Object store (MinIO, T1.1). Root credentials for the local store only, matching the
# AISRE_OBJECT_STORE_* and AISRE_AUDIT_STORE_* keys above; the minio-bucket job creates both
# buckets.
MINIO_ROOT_USER=fake-minio-admin
MINIO_ROOT_PASSWORD=fake-minio-password

# Host ports, bound to 127.0.0.1. Change one if it clashes with something already running.
AISRE_POSTGRES_PORT=55432
AISRE_TEMPORAL_PORT=7233
AISRE_TEMPORAL_UI_PORT=8233
AISRE_API_PORT=8000
AISRE_MINIO_PORT=59000
AISRE_MINIO_CONSOLE_PORT=59001
AISRE_OTLP_GRPC_PORT=54317
AISRE_OTLP_HTTP_PORT=54318
AISRE_PROMETHEUS_PORT=59090
AISRE_ISSUER_PORT=59100
AISRE_FAKE_PROVIDER_PORT=59200
AISRE_FAKE_MONITORING_PORT=59300
