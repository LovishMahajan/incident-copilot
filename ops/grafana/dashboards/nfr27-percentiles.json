    {
      "id": 10,
      "type": "table",
      "title": "Human wait: approval request to decision (seconds, nearest rank)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "aisre-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "aisre-postgres"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT percentile_disc(0.5) WITHIN GROUP (ORDER BY w) AS p50, percentile_disc(0.95) WITHIN GROUP (ORDER BY w) AS p95, percentile_disc(0.99) WITHIN GROUP (ORDER BY w) AS p99, count(*) AS n FROM (SELECT EXTRACT(EPOCH FROM d.decided_at - r.requested_at) AS w FROM approval_decisions d JOIN approval_requests r USING (approval_request_id) WHERE $__timeFilter(d.decided_at)) x"
        }
      ]
    },
    {
      "id": 11,
      "type": "table",
      "title": "End to end: alert to close (seconds, nearest rank)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "aisre-postgres"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "aisre-postgres"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT percentile_disc(0.5) WITHIN GROUP (ORDER BY e) AS p50, percentile_disc(0.95) WITHIN GROUP (ORDER BY e) AS p95, percentile_disc(0.99) WITHIN GROUP (ORDER BY e) AS p99, count(*) AS n FROM (SELECT EXTRACT(EPOCH FROM closed_at - started_at) AS e FROM incidents WHERE status = 'closed' AND $__timeFilter(closed_at)) x"
        }
      ]
    }
