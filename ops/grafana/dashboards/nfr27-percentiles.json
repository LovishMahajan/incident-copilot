            "type": "prometheus",
            "uid": "aisre-prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le, severity) (rate(aisre_incident_queue_wait_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p99 {{severity}}"
