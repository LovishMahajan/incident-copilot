{
  "uid": "aisre-nfr27",
  "title": "Incident Copilot: percentiles (NFR-27)",
  "description": "M4 T4.7: the six measurements of Artifact 4.4 by percentile. Histograms from Prometheus; human wait and end-to-end from PostgreSQL (nearest rank, 12.9).",
  "tags": [
    "aisre",
    "nfr-27"
  ],
  "timezone": "utc",
  "schemaVersion": 41,
  "version": 1,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Queue wait (NFR-16, 4.4)",
      "datasource": {
        "type": "prometheus",
        "uid": "aisre-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "aisre-prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le, severity) (rate(aisre_incident_queue_wait_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p50 {{severity}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "aisre-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, severity) (rate(aisre_incident_queue_wait_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p95 {{severity}}"
        },
